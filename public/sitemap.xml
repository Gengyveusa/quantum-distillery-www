<?xml version="1.0" encoding="UTF-8"?>
<!--
  One URL, and that is correct.

  src/main.tsx mounts a HashRouter, so /sim and /instructor are hash fragments
  (/#/sim, /#/instructor). Hash fragments are never sent to the server and are
  not indexable as distinct URLs — listing them here would be listing URLs that
  do not exist as far as any crawler is concerned.

  Giving the simulator and other sections their own indexable URLs requires
  switching HashRouter to BrowserRouter (public/_redirects already has the
  SPA catch-all needed to support it) and prerendering each route. Until then,
  this site is genuinely one page and the sitemap says so.

  /undercut is deliberately excluded — word-gated preview, also Disallowed
  in robots.txt.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://thequantumdistillery.com/</loc>
    <lastmod>2026-07-27</lastmod>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
</urlset>
